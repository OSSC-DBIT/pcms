# PCMS production settings. Copy to /srv/pcms/pcms.env, chmod 600, owner = the service account.
# Never commit the filled-in file. Secrets that Docker can mount as files live in ./secrets/.

# Database (the password must match secrets/db_password)
PCMS_DATABASE_URL=postgresql+asyncpg://pcms:CHANGE_ME_DB_PASSWORD@db:5432/pcms

# 64 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
PCMS_SECRET_KEY=CHANGE_ME

# Encrypts temporary passwords until the person sets their own. Separate from PCMS_SECRET_KEY.
# Generate another 64 random characters with the same command. Never reuse SECRET_KEY here.
PCMS_CREDENTIAL_KEY=CHANGE_ME

PCMS_COLLEGE_CODE=DB
PCMS_TIMEZONE=Asia/Kolkata
# The address people open. Used in email links, so it must be the hostname they
# can actually reach: the campus DNS name, or the Cloudflare tunnel hostname
# when PCMS is published that way.
PCMS_PUBLIC_APP_URL=https://pcms.dbit.edu.in
# Hostname of the Cloudflare tunnel that forwards to nginx:8081 (webhooks + signed photos only)
PCMS_PUBLIC_BASE_URL=https://pcms-hooks.dbit.edu.in

# Email through the college SMTP relay
PCMS_SMTP_HOST=smtp.dbit.edu.in
PCMS_SMTP_PORT=587
PCMS_SMTP_STARTTLS=true
PCMS_SMTP_USERNAME=
PCMS_SMTP_PASSWORD=
PCMS_SMTP_FROM=PCMS Facilities <pcms@dbit.edu.in>

# Worker messaging: twilio, or none (call and job card only) until Twilio is approved
PCMS_MESSAGING_PROVIDER=none
PCMS_TWILIO_ACCOUNT_SID=
PCMS_TWILIO_AUTH_TOKEN=
PCMS_TWILIO_WHATSAPP_FROM=whatsapp:+91XXXXXXXXXX
PCMS_TWILIO_SMS_FROM=
PCMS_TWILIO_JOB_CONTENT_SID=
PCMS_TWILIO_JOB_MEDIA_CONTENT_SID=
PCMS_FACILITIES_DESK_PHONE=+91 80 XXXX XXXX

# Web push: python -m app.cli vapid-keys
PCMS_VAPID_PUBLIC_KEY=
PCMS_VAPID_PRIVATE_KEY=
PCMS_VAPID_SUBJECT=mailto:facilities@dbit.edu.in

# Policy (proposed pilot values, plan 9.1)
PCMS_DISPUTE_WINDOW_DAYS=7
PCMS_VERIFY_REMINDER_DAYS=2
PCMS_TEMP_PASSWORD_DAYS=7
# Close resolved tickets the reporter never answered, after this many days.
# Keep AUTO_CLOSE_ENABLED false during the pilot and watch the queue by hand;
# set it true once the team trusts the flow.
PCMS_AUTO_CLOSE_DAYS=5
PCMS_AUTO_CLOSE_ENABLED=false

# Retention (days). History is append-only, so the nightly prune is the only
# thing that ever deletes it. Tickets, tokens and ratings are never pruned;
# only the timeline and messages of long-closed tickets. 0 disables a prune.
PCMS_RETENTION_AUDIT_DAYS=1095
PCMS_RETENTION_TICKET_HISTORY_DAYS=1095
PCMS_RETENTION_OUTBOX_DAYS=90
PCMS_RETENTION_PROVIDER_EVENT_DAYS=90

# Compose-level settings (read by docker compose, not the app)
PCMS_CERT_DIR=/srv/pcms/certs
PCMS_SECRETS_DIR=/srv/pcms/secrets
PCMS_BACKUP_DIR=/srv/pcms/backups
PCMS_BACKUP_AT=0130

# Cloudflare tunnel (optional; see docs/DEPLOYMENT.md section 6). Publishes
# PCMS over HTTPS with no inbound ports open on the server. Get the token from
# Zero Trust > Networks > Tunnels > Create a tunnel > cloudflared, then start
# the stack with --profile tunnel. Empty leaves the tunnel off.
# Protect the app hostname with Cloudflare Access: only the super admin has a
# second factor, so the sign-in page should not face the open internet.
PCMS_TUNNEL_TOKEN=
