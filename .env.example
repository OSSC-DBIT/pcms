# PCMS production settings. Copy to /srv/production/pcms/pcms.env, chmod 600, owner = the service account.
# Never commit the filled-in file. If a value contains $, wrap the whole value in single quotes.

# ---------- Database ----------
# PostgreSQL creates this login the first time it starts with an empty data volume.
# Changing it later does not change the existing database; see docs/DEPLOYMENT.md.
# Password: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
PCMS_DB_NAME=pcms
PCMS_DB_USER=pcms
PCMS_DB_PASSWORD=CHANGE_ME

# ---------- Ports on this server ----------
# nginx is the only container with ports. HTTP only redirects to HTTPS.
PCMS_HTTP_PORT=80
PCMS_HTTPS_PORT=443

# ---------- Address ----------
# The exact https address people open. The API accepts requests only from this origin.
PCMS_PUBLIC_APP_URL=https://pcms.dbit.edu.in
# Only if PCMS is also reached by another name: extra origins and hosts, comma-separated.
# PCMS_ALLOWED_ORIGINS=https://maintenance.dbit.edu.in
# PCMS_ALLOWED_HOSTS=maintenance.dbit.edu.in

# ---------- App secrets ----------
# 64 random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PCMS_SECRET_KEY=CHANGE_ME
# Encrypts temporary passwords until each person sets their own. Generate a separate value.
PCMS_CREDENTIAL_KEY=CHANGE_ME

# ---------- Team OSSC admins ----------
# After the stack is up, run once (safe to re-run; existing accounts are skipped):
#   docker compose -f compose.prod.yml exec api python -m app.cli create-admin-from-env
# Add as many as you need: PCMS_ADMIN_3_EMAIL, PCMS_ADMIN_4_EMAIL, and so on. Empty slots are ignored.
# Password: at least 10 characters, not the email. Leave it empty to have one generated and printed.
# Every password here is temporary: it must be changed at first sign-in, then an authenticator
# app is set up. Clear these values after the admins have signed in.
PCMS_ADMIN_1_EMAIL=
PCMS_ADMIN_1_NAME=
PCMS_ADMIN_1_PASSWORD=
PCMS_ADMIN_2_EMAIL=
PCMS_ADMIN_2_NAME=
PCMS_ADMIN_2_PASSWORD=

# ---------- General ----------
PCMS_COLLEGE_CODE=DB
PCMS_TIMEZONE=Asia/Kolkata

# ---------- Notifications: web push (the only channel) ----------
# Required. Generate once and keep: python -m app.cli vapid-keys
# Changing the keys later signs everyone's devices out of notifications until they open the app again.
PCMS_VAPID_PUBLIC_KEY=
PCMS_VAPID_PRIVATE_KEY=
# A real contact the browser push services can reach if something goes wrong.
PCMS_VAPID_SUBJECT=mailto:facilities@dbit.edu.in

# Translation of typed text between English, Kannada and Hindi (done by the worker).
# mymemory: the free public MyMemory API. Ticket text is sent to MyMemory (a third party).
# none: show only the original text. An email raises the free limit to 50000 characters a day.
PCMS_TRANSLATION_PROVIDER=mymemory
PCMS_TRANSLATION_EMAIL=
# Backup when MyMemory fails or runs out: google (unofficial Google Translate endpoint, text goes to Google) or none.
PCMS_TRANSLATION_FALLBACK=google

# Policy (proposed pilot values, plan 9.1)
PCMS_DISPUTE_WINDOW_DAYS=7
PCMS_VERIFY_REMINDER_DAYS=2
PCMS_AUTO_CLOSE_DAYS=5
PCMS_TEMP_PASSWORD_DAYS=7

# Compose-level settings (read by docker compose, not the app)
PCMS_CERT_DIR=/srv/production/pcms/certs
PCMS_SECRETS_DIR=/srv/production/pcms/secrets
PCMS_BACKUP_DIR=/srv/production/pcms/backups
PCMS_BACKUP_AT=0130
